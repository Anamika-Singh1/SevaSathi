# Copy to ignored .env.local for setup. Never commit real keys or passwords.
# Vercel application settings: use HOSTED Supabase values, never 127.0.0.1.
# Set these public values before building; rebuild after changes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Trusted setup/test environment only; omit this from the Vercel application.
# Use a Supabase secret key (sb_secret_...) or the legacy service_role key.
SUPABASE_SECRET_KEY=

# Trusted setup/test environment only; omit these from the Vercel application.
# Supply four distinct demo passwords yourself (12 to 128 characters each).
# Demo emails are fictional addresses under the reserved example.com domain.
DEMO_OPERATOR_PASSWORD=
DEMO_FIELD_OFFICER_PASSWORD=
DEMO_CASEWORKER_PASSWORD=
DEMO_APPROVING_OFFICER_PASSWORD=

# Opt-in for integration tests and demo:case on a dedicated disposable demo project.
# Keep false on production citizen data; test suites temporarily modify access/settings.
SEVASATHI_TEST_DEMO_PROJECT=false
TEST_BASE_URL=http://127.0.0.1:3000

# Server-only Gemini configuration. Never use NEXT_PUBLIC_ for the API key.
# Obtain a key privately from Google AI Studio, then restart the application.
GEMINI_API_KEY=
# Supported text model with structured JSON output; verify access for your key.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional local browser override when the default Playwright Chromium is absent.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
