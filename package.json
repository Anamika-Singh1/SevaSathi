{
  "name": "sevasathi",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "tsx --env-file=.env.local --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "node --env-file=.env.local node_modules/@playwright/test/cli.js test",
    "test:workflow:database": "tsx --env-file=.env.local scripts/test-workflow-atomicity.ts",
    "test:ai:database": "tsx --env-file=.env.local scripts/test-ai-quota.ts",
    "test:security:database": "tsx --env-file=.env.local scripts/test-security-database.ts",
    "test:secrets": "tsx --env-file=.env.local scripts/test-secret-exposure.ts",
    "demo:setup": "tsx --env-file=.env.local scripts/setup-demo.ts",
    "demo:case": "tsx --env-file=.env.local scripts/create-demo-case.ts",
    "demo:local-env": "tsx scripts/init-local-env.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:types": "tsx scripts/generate-db-types.ts"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.109.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.0",
    "supabase": "^2.76.0",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.5"
  }
}
